(version 1)

# Единицы обязательны: число без «mm» KiCad читает в нанометрах, и правило молча не действует.

# Сетевые цепи между собой: общий минимум для дорожек и переходных.
# Узлы делителя детектора нуля (R101–R104, D101) — под частью сетевого напряжения.
(rule "Сеть: прочие цепи"
	(condition "A.NetClass == 'Mains' && B.NetClass == 'Mains' && (A.Type == 'Track' || A.Type == 'Via') && !(A.intersectsArea('Q101_PINS') && B.intersectsArea('Q101_PINS'))")
	(constraint clearance (min 1.0mm)))

# Функциональная изоляция между группами под полным сетевым напряжением (250 В, загрязнение 2,
# материал IIIa — путь утечки 2,5 мм по IEC 60664-1):
#   фаза:     L, LF, вывод 6 MOC3052 (через R107 на фазу)
#   ноль:     N
#   нагрузка: OUT и управляющий электрод симистора (через переход G–T1 на OUT)
# Выводы TO-220 симистора (шаг 2,54) исключены — их зазор задан корпусом.
# Проверяется зазор: на плате без прорезей он совпадает с путём утечки по поверхности, а
# проверка creepage в KiCad 10 не учитывает исключение по области Q101_PINS.
(rule "Сеть: фаза–ноль–нагрузка"
	(condition "!(A.intersectsArea('Q101_PINS') && B.intersectsArea('Q101_PINS')) && (((A.NetName == '/Силовая часть 230 В/L' || A.NetName == '/Силовая часть 230 В/LF' || A.NetName == 'Net-(R107-Pad2)') && (B.NetName == '/Силовая часть 230 В/N' || B.NetName == '/Силовая часть 230 В/OUT' || B.NetName == 'Net-(Q101-G)')) || (A.NetName == '/Силовая часть 230 В/N' && (B.NetName == '/Силовая часть 230 В/OUT' || B.NetName == 'Net-(Q101-G)')))")
	(constraint clearance (min 2.5mm)))

# Усиленная изоляция сеть 230 В — низковольтная часть (SELV): зазор и путь утечки 6 мм.
(rule "Изоляция сеть-НН"
	(condition "A.NetClass == 'Mains' && B.NetClass == 'LV'")
	(constraint clearance (min 6.0mm))
	(constraint creepage (min 6.0mm)))
